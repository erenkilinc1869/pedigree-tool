    given-names: "Eren"
    affiliation: "Department of Medical Genetics, Erciyes University, Kayseri, Türkiye"
version: "1.7.2"
date-released: "2026-11-18"
license: GPL-3.0-or-later
repository-code: "https://github.com/erenkilinc1869/pedigree-tool"
keywords:
  - pedigree
  - family tree
  - medical genetics
  - genetic counselling
  - pedigree drawing
  - PowerPoint

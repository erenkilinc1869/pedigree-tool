{
  "name": "pedigree-tool",
  "private": true,
  "version": "1.7.3",
  "description": "Genetik bölümü için pedigri (soy ağacı) çizim aracı.",
  "author": "Eren Kılınç",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.erenkilinc.pedigreetool",
    "productName": "Pedigree Tool",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "LICENSE", "to": "../LICENSE.txt" },
      { "from": "THIRD-PARTY-NOTICES.txt", "to": "../THIRD-PARTY-NOTICES.txt" }
    ],
    "win": {
      "target": ["dir", "zip"],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    }
  }
}
